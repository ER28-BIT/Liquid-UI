{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Liquid UI",
    "version": "0.1.0",
    "status": "foundation",
    "description": "Shared, product-neutral design tokens for Resonance products."
  },
  "color": {
    "canvas": { "default": "#F6F8F6", "subtle": "#EEF3EF", "inverse": "#10241D" },
    "surface": { "default": "#FFFFFF", "raised": "#FAFCFA", "glass": "rgba(255, 255, 255, 0.78)", "inverse": "#183229" },
    "text": { "primary": "#14231D", "secondary": "#4B5E56", "muted": "#6B7C74", "inverse": "#F7FBF8", "link": "#126B50" },
    "border": { "subtle": "#DDE6E0", "strong": "#AABCB2", "focus": "#0E7A59" },
    "brand": { "primary": "#126B50", "strong": "#0A4A38", "soft": "#DDF2E8", "aqua": "#4D9D98", "gold": "#B58A3B" },
    "status": {
      "verified": { "foreground": "#075D42", "background": "#DDF5E9", "border": "#82CCAA" },
      "pending": { "foreground": "#75520A", "background": "#FFF2CF", "border": "#E2C46D" },
      "notReady": { "foreground": "#8A3C12", "background": "#FDE8D8", "border": "#E7A376" },
      "warning": { "foreground": "#7A4C00", "background": "#FFF0C2", "border": "#DBB451" },
      "rejected": { "foreground": "#8A2530", "background": "#FBE3E6", "border": "#E39AA3" },
      "simulated": { "foreground": "#3D4778", "background": "#E8EAF7", "border": "#AEB5DC" },
      "restricted": { "foreground": "#4F3D68", "background": "#EEE8F5", "border": "#BDAFD0" }
    }
  },
  "font": {
    "family": { "sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "mono": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Consolas, monospace" },
    "size": { "xs": "0.75rem", "sm": "0.875rem", "md": "1rem", "lg": "1.125rem", "xl": "1.375rem", "2xl": "1.75rem", "3xl": "2.25rem" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "tight": 1.2, "normal": 1.5, "relaxed": 1.65 }
  },
  "space": { "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem", "6": "1.5rem", "8": "2rem", "10": "2.5rem", "12": "3rem", "16": "4rem" },
  "radius": { "sm": "0.5rem", "md": "0.75rem", "lg": "1rem", "xl": "1.5rem", "pill": "999px" },
  "shadow": { "sm": "0 1px 2px rgba(16, 36, 29, 0.08)", "md": "0 10px 30px rgba(16, 36, 29, 0.10)", "focus": "0 0 0 3px rgba(14, 122, 89, 0.28)" },
  "motion": { "fast": "120ms", "normal": "200ms", "slow": "320ms", "ease": "cubic-bezier(0.2, 0, 0, 1)" },
  "layout": { "contentMax": "80rem", "readingMax": "46rem", "controlHeight": "2.75rem" }
}
