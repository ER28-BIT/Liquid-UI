{
  "color": {
    "palette": {
      "ink": "#17202a",
      "paper": "#ffffff",
      "mist": "#f3f6f8",
      "sky": "#0b6e99",
      "sky-dark": "#084c6b",
      "line": "#d5dde3",
      "danger": "#b42318"
    },
    "surface": {
      "default": "{color.palette.paper}",
      "muted": "{color.palette.mist}"
    },
    "content": {
      "default": "{color.palette.ink}",
      "muted": "#52616b",
      "on-action": "{color.palette.paper}",
      "danger": "{color.palette.danger}"
    },
    "border": {
      "default": "{color.palette.line}",
      "focus": "{color.palette.sky}"
    },
    "action": {
      "primary": "{color.palette.sky}",
      "primary-hover": "{color.palette.sky-dark}"
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem"
  },
  "font": {
    "family-sans": "Inter, ui-sans-serif, system-ui, sans-serif",
    "size-sm": "0.875rem",
    "size-md": "1rem",
    "size-lg": "1.25rem",
    "size-xl": "1.5rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "pill": "999px"
  },
  "focus": {
    "ring": "0 0 0 3px color-mix(in srgb, {color.border.focus} 35%, transparent)"
  }
}
